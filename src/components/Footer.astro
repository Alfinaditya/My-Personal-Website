---
import { site } from '@/site';

const links = [
	{
		label: 'GitHub',
		href: site.github,
		external: true,
		icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
	},
	{
		label: 'Email',
		href: `mailto:${site.email}`,
		external: false,
		icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
	},
	{
		label: 'LinkedIn',
		href: site.linkedin,
		external: true,
		icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
	},
	{
		label: 'RSS',
		href: '/rss.xml',
		external: false,
		icon: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
	},
];
const year = new Date().getFullYear();
---

<footer class="flex flex-wrap items-center gap-x-7 gap-y-2 text-[15px] text-muted">
	{
		links.map((link) => (
			<a
				href={link.href}
				class="inline-flex min-h-11 items-center gap-2 text-muted no-underline transition-colors hover:text-white"
				{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			>
				<svg
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					set:html={link.icon}
				/>
				{link.label}
			</a>
		))
	}
	<span class="ml-auto font-mono text-[13px]">© {year} {site.name}</span>
</footer>
